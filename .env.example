# Nawāt — copy to .env and edit. Nothing here is baked into a script or an image.
#
#   cp .env.example .env && $EDITOR .env
#
# nawat finds .env by itself: the nearest one at or above the working directory.
# Nothing to source. Exported environment variables still win over this file, so
# you can override a single value for a single command.
#
# Every variable below is read at process start, so a training script that reads
# NAWAT_* runs identically inside and outside the platform.

# ---------------------------------------------------------------------------
# Object storage — RustFS. This is the source of truth for everything.
# ---------------------------------------------------------------------------

NAWAT_S3_ENDPOINT=http://127.0.0.1:9000
NAWAT_S3_BUCKET=nawat
NAWAT_S3_REGION=us-east-1

# Must match RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY on the RustFS host.
# These are read from the environment and never written to a log, a run record
# or an API response. Put the real values in .env, which is gitignored — this file is a
# template and is committed.
NAWAT_S3_ACCESS_KEY=rustfsadmin
NAWAT_S3_SECRET_KEY=change-me-before-first-use

# Optional: confine Nawāt to a prefix inside a shared bucket.
# NAWAT_S3_PREFIX=

# Alternative backend for working without a store running. Not for real use:
# a "replica" on the same disk is not a replica.
# NAWAT_STORE_BACKEND=local
# NAWAT_LOCAL_STORE_ROOT=/var/lib/nawat/object-store

# ---------------------------------------------------------------------------
# Local disk — the disposable cache
# ---------------------------------------------------------------------------

NAWAT_CACHE_ROOT=/home/lap/nawat/cache
NAWAT_WORKSPACE=/home/lap/nawat/workspace
# NAWAT_STATE_DIR defaults to $NAWAT_CACHE_ROOT/.nawat

# The cache is held beneath this by evicting least-recently-used artifacts.
# Size it for the working set, not for the disk: on a 200 GB NVMe, 120 GB holds
# two 16 GB bases, their adapters and a dataset with room for checkpoints.
NAWAT_CACHE_CEILING=120GB

# Filesystem headroom never consumed by the cache, for scratch and checkpoints.
NAWAT_MIN_FREE=10GB

# ---------------------------------------------------------------------------
# Transfers
# ---------------------------------------------------------------------------

NAWAT_TRANSFER_WORKERS=8
NAWAT_MULTIPART_THRESHOLD=64MB
NAWAT_MULTIPART_CHUNK=32MB

# ---------------------------------------------------------------------------
# Upstream hub — consulted at most once per artifact, ever
# ---------------------------------------------------------------------------

# Set to 1 once models and datasets are seeded. Training subprocesses run with
# this forced on regardless, so a run can never silently download.
NAWAT_OFFLINE=0

# HF_TOKEN=

# ---------------------------------------------------------------------------
# Agent-assisted authoring — optional; the platform is complete without it
# ---------------------------------------------------------------------------
#
# claude: the Claude Agent SDK (needs the claude CLI installed and logged in).
#   Read-only over the workspace; every proposal passes your diff review.
#   The backend receives training code and run metrics — never datasets,
#   weights, or credentials.
# local: any OpenAI-compatible endpoint — keeps the whole loop on-premises.
#
# NAWAT_AGENT_BACKEND=claude
# NAWAT_AGENT_MODEL=
# NAWAT_AGENT_URL=http://127.0.0.1:8001
# NAWAT_AGENT_API_KEY=

# ---------------------------------------------------------------------------
# RustFS itself
# ---------------------------------------------------------------------------
#
# RustFS runs as a systemd service on this host, not as part of Nawāt. Its own
# credentials and data directory live in /etc/default/rustfs:
#
#   RUSTFS_ACCESS_KEY   must match NAWAT_S3_ACCESS_KEY above
#   RUSTFS_SECRET_KEY   must match NAWAT_S3_SECRET_KEY above
#   RUSTFS_VOLUMES      where the 8 TB store lives, e.g. /data/rustfs0
#   RUSTFS_ADDRESS      :9000 — keep it on the loopback or the local network
#
# After editing that file:  sudo systemctl restart rustfs
# Then confirm this end:    nawat check --create-bucket
