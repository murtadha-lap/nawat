# Nawāt control plane — API, run queue, web interface, session supervision.
#
#   sudo cp deploy/nawat-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nawat-api
#
# Every service restarts unattended after a reboot and recovers to a consistent
# state (NFR-3.2): on startup the platform reconciles the cache against disk,
# reaps leases whose holders died, and marks runs that did not survive as
# failed. RustFS has its own unit; this one only needs it reachable.

[Unit]
Description=Nawat control plane
After=network-online.target rustfs.service
Wants=network-online.target

[Service]
Type=simple
User=lap
WorkingDirectory=/home/lap/lap/tr
# Configuration comes from .env in the working directory — nawat reads it itself.
ExecStart=/home/lap/lap/tr/.venv/bin/nawat api
Restart=on-failure
RestartSec=5
# The queue runs trainers as children; give the whole group time to stop cleanly.
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
